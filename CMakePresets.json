{
    "version": 6,
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Development (tests only)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CTRLPP_BUILD_TESTS": "ON",
                "CTRLPP_CMAKE_FETCH_DEPS": "ON",
                "CTRLPP_INSTALL": "OFF"
            }
        },
        {
            "name": "dev-full",
            "displayName": "Full development (tests + examples + fuzz + property)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dev-full",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CTRLPP_BUILD_TESTS": "ON",
                "CTRLPP_BUILD_EXAMPLES": "ON",
                "CTRLPP_BUILD_FUZZ_TESTS": "ON",
                "CTRLPP_BUILD_PROPERTY_TESTS": "ON",
                "CTRLPP_CMAKE_FETCH_DEPS": "ON",
                "CTRLPP_INSTALL": "OFF"
            }
        },
        {
            "name": "exceptions",
            "displayName": "Exceptions carve-out (throwing-wrapper + OSQP/NLopt tests, Catch2 exceptions-on)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/exceptions",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CTRLPP_BUILD_TESTS": "ON",
                "CTRLPP_CMAKE_FETCH_DEPS": "ON",
                "CTRLPP_INSTALL": "OFF",
                "CTRLPP_TESTS_WITH_EXCEPTIONS": "ON",
                "CTRLPP_BUILD_OSQP": "ON",
                "CTRLPP_BUILD_NLOPT": "ON"
            }
        },
        {
            "name": "dev-cxx23",
            "displayName": "Development above the C++20 floor (checks the other ctrlpp::expected resolution)",
            "inherits": "dev",
            "binaryDir": "${sourceDir}/build/dev-cxx23",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23"
            }
        },
        {
            "name": "exceptions-cxx23",
            "displayName": "Exceptions carve-out above the C++20 floor (checks the other ctrlpp::expected resolution)",
            "inherits": "exceptions",
            "binaryDir": "${sourceDir}/build/exceptions-cxx23",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23"
            }
        },
        {
            "name": "coverage",
            "displayName": "Coverage (GCC + gcov)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/coverage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
                "CTRLPP_BUILD_TESTS": "ON",
                "CTRLPP_ENABLE_COVERAGE": "ON",
                "CTRLPP_CMAKE_FETCH_DEPS": "ON",
                "CTRLPP_INSTALL": "OFF"
            }
        },
        {
            "name": "coverage-full",
            "displayName": "Full coverage (GCC + gcov + solvers + property tests)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/coverage-full",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
                "CTRLPP_BUILD_TESTS": "ON",
                "CTRLPP_ENABLE_COVERAGE": "ON",
                "CTRLPP_BUILD_OSQP": "ON",
                "CTRLPP_BUILD_NLOPT": "ON",
                "CTRLPP_BUILD_PROPERTY_TESTS": "ON",
                "CTRLPP_CMAKE_FETCH_DEPS": "ON",
                "CTRLPP_INSTALL": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev"
        },
        {
            "name": "dev-full",
            "configurePreset": "dev-full"
        },
        {
            "name": "exceptions",
            "configurePreset": "exceptions"
        },
        {
            "name": "dev-cxx23",
            "configurePreset": "dev-cxx23"
        },
        {
            "name": "exceptions-cxx23",
            "configurePreset": "exceptions-cxx23"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        },
        {
            "name": "coverage-full",
            "configurePreset": "coverage-full"
        }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "exceptions",
            "configurePreset": "exceptions",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "dev-cxx23",
            "configurePreset": "dev-cxx23",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "exceptions-cxx23",
            "configurePreset": "exceptions-cxx23",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "coverage-full",
            "configurePreset": "coverage-full",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
